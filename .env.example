# Database
# Local development uses the Neon `dev` branch connection string:
DATABASE_URI=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# On Vercel, Neon integration provides DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct).
# Local PostgreSQL 18 (postgresql-x64-18) is an optional offline fallback.

# Payload
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email (SMTP via Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=AB Tours UAE
EMAIL_FROM_ADDRESS=no-reply@example.com

# Media storage (Vercel Blob, enabled only when BLOB_READ_WRITE_TOKEN is set)
BLOB_READ_WRITE_TOKEN=

# Preview & Scheduled Jobs
PREVIEW_SECRET=replace-with-a-random-preview-secret
CRON_SECRET=replace-with-a-random-cron-secret
